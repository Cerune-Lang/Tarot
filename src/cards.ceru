// Cerune tarot card data: this module is intentionally data-only.
// It exports Card, Advice, CARDS, ADVICES; the program entry point is main.ceru.
// Keep display text and metadata here, not in the generated public/data/cards.txt.
// The record output protocol is defined and written by export.ceru.

pub type Card {
    id: string,
    name: string,
    en: string,
    arcana: string,
    suit: string,
    number: i32,
    symbol: string,
    upright: string,
    reversed: string,
    upright_tags: string,
    reversed_tags: string,
}

pub type Advice {
    topic: string,
    tags: string,
    message: string,
}

