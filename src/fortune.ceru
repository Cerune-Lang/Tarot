// Native CLI: fortune.exe <seed> <1|3> <general|love|work|relations>
// Shares the card data and selection functions used by the Web version.
import "std:env" as env;
import "std:num" as num;
import "cards.ceru" as deck;
import "tarot.ceru" as tarot;

fn argument_number(index: i64) -> num::ParseI64 {
    match env::arg(index) {
        env::Argument::Value { text: text } => { return num::parse_i64(text); },
        env::Argument::Missing {} => { return num::ParseI64::InvalidFormat {}; },
    }
}

fn next_seed(seed: i64) -> i64 {
    return (seed * 48271) % 2147483647;
}

fn main() -> void {
    if env::arg_count() != 3 {
        print("usage: fortune <seed> <1|3> <general|love|work|relations>");
        return;
    }

    mut seed: i64 = 0;
    match argument_number(0) {
        num::ParseI64::Value { value: value } => { seed = value; },
        num::ParseI64::InvalidFormat {} => { print("invalid seed"); return; },
        num::ParseI64::OutOfRange {} => { print("invalid seed"); return; },
    }

    mut count: i64 = 0;
    match argument_number(1) {
        num::ParseI64::Value { value: value } => { count = value; },
        num::ParseI64::InvalidFormat {} => { print("invalid count"); return; },
        num::ParseI64::OutOfRange {} => { print("invalid count"); return; },
    }

    mut topic: string = "general";
    match env::arg(2) {
        env::Argument::Value { text: text } => { topic = text; },
        env::Argument::Missing {} => { print("invalid topic"); return; },
    }

    if seed < 1 || seed > 2147483646 || (count != 1 && count != 3) {
        print("seed must be 1..2147483646 and count must be 1 or 3");
        return;
    }

    mut advice_offset: i64 = 0;

    if topic == "love" {
        advice_offset = 3;
    }
    if topic == "work" {
        advice_offset = 6;
    }
    if topic == "relations" {
        advice_offset = 9;
    }
    if topic != "general" && topic != "love" &&
    topic != "work" && topic != "relations" {
        print("invalid topic");
        return;
    }

    // Swap selected indices out of the pool: a 3-card draw cannot repeat cards.
    mut pool: [i64] = array_repeat::<i64>(0, 78);
    for (mut i: i64 = 0; i < 78; i = i + 1) {
        pool[i] = i;
    }

    print("CERUNE_TAROT_DRAW");
    print(count);

    for (mut i: i64 = 0; i < count; i = i + 1) {
        remaining: i64 = 78 - i;
        seed = next_seed(seed);
        choice: i64 = convert<i64>(tarot::draw_index(convert<i32>(seed), convert<i32>(remaining)));
        card_index: i64 = pool[choice];
        pool[choice] = pool[remaining - 1];

        seed = next_seed(seed);
        reversed: bool = tarot::is_reversed(convert<i32>(seed)) == 1;
        card: deck::Card = deck::CARDS[card_index];
        advice: deck::Advice = deck::ADVICES[advice_offset + i];

        print(card.id);
        print(card.name);
        if reversed {
            print("逆位置");
            print(card.reversed);
        } else {
            print("正位置");
            print(card.upright);
        }
        print(advice.message);
    }
    print("END");
}
